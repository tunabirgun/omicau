{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "omicau benchmark result row",
  "type": "object",
  "required": ["run_id", "protocol_version", "profile", "phase", "dataset_id", "simulation", "task", "method_id", "tuning_arm", "split_id", "repeat", "primary_metric", "primary_value", "secondary_metrics", "n_subjects", "n_samples", "n_features_per_modality", "modalities", "oof_predictions_path", "cost", "software", "provenance_hash", "timestamp_utc"],
  "properties": {
    "run_id": {"type": "string", "minLength": 1},
    "protocol_version": {"type": "string", "const": "1.0.0"},
    "profile": {"type": "string", "enum": ["smoke", "core", "full"]},
    "phase": {"type": "string", "enum": ["development", "definitive"]},
    "dataset_id": {"type": "string", "minLength": 1},
    "simulation": {"type": "object", "required": ["scenario", "sample_size", "replicate", "seed", "ground_truth_roles"]},
    "task": {"type": "string", "minLength": 1},
    "method_id": {"type": "string", "minLength": 1},
    "tuning_arm": {"type": "string", "minLength": 1},
    "split_id": {"type": "string", "minLength": 1},
    "split_sha256": {"type": "string"},
    "repeat": {"type": "integer", "minimum": 0},
    "primary_metric": {"type": "string", "minLength": 1},
    "primary_value": {"type": ["number", "null"]},
    "secondary_metrics": {"type": "object"},
    "audit": {"type": "object"},
    "control_baselines": {"type": "object"},
    "n_subjects": {"type": "integer", "minimum": 1},
    "n_samples": {"type": "integer", "minimum": 1},
    "n_features_per_modality": {"type": "object"},
    "modalities": {"type": "array", "items": {"type": "string"}},
    "oof_predictions_path": {"type": ["string", "null"]},
    "cost": {"type": "object"},
    "software": {"type": "object"},
    "provenance_hash": {"type": "string", "minLength": 1},
    "timestamp_utc": {"type": "string", "minLength": 1},
    "notes": {"type": "string"}
  },
  "additionalProperties": true
}
